{
  "name": "guts-and-gems",
  "version": "0.4.0",
  "private": true,
  "description": "Prototype: a tiny miner inside a hungry creature. Turn-based tool-card puzzle, all art generated by code.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "VITE_TARGET=crazygames npm run build",
    "package:crazygames": "node scripts/package-portal.mjs",
    "typecheck": "tsc --noEmit",
    "sim": "tsx scripts/sim.ts",
    "smoke": "node scripts/smoke.mjs",
    "dev:salvage": "vite -c vite.salvage.config.ts",
    "build:salvage": "tsc --noEmit && vite build -c vite.salvage.config.ts && mv dist-salvage/salvage.html dist-salvage/index.html",
    "sim:salvage": "tsx scripts/salvage-sim.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.0"
  }
}
